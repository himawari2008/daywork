/* ========================================
   活记 · 隐私锁屏
   对标 Day One / 声间 — 安全 + 温暖
   零 emoji · CSS 纯图标
   ======================================== */

.page {
  height: 100vh;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.lock-container {
  width: 100%;
  max-width: 560rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
}

/* ===== 品牌标识 ===== */
.lock-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
}

.lock-logo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  background: var(--accent-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

/* CSS 锁图标 */
.css-icon-lock {
  width: 32rpx;
  height: 26rpx;
  border: 3rpx solid var(--accent);
  border-radius: 4rpx;
  position: relative;
  top: -6rpx;
}
.css-icon-lock::before {
  content: '';
  width: 18rpx;
  height: 14rpx;
  border: 3rpx solid var(--accent);
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
  position: absolute;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
}
.css-icon-lock::after {
  content: '';
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--accent);
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.lock-app-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.lock-hint {
  font-size: 26rpx;
  color: var(--ink-soft);
  text-align: center;
}

/* ===== PIN 圆点 ===== */
.pin-dots {
  display: flex;
  gap: 28rpx;
  margin-bottom: 56rpx;
}

.pin-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 2rpx solid var(--ink-faint);
  transition: all 0.2s ease;
}

.pin-dot.filled {
  background: var(--ink);
  border-color: var(--ink);
  transform: scale(1.15);
}

.pin-dot.shake {
  animation: pin-shake 0.5s ease;
}

@keyframes pin-shake {
  0%, 100% { transform: translateX(0); }
  10% { transform: translateX(-12rpx); }
  20% { transform: translateX(12rpx); }
  30% { transform: translateX(-8rpx); }
  40% { transform: translateX(8rpx); }
  50% { transform: translateX(-4rpx); }
  60% { transform: translateX(4rpx); }
}

/* ===== 数字键盘 ===== */
.num-pad {
  width: 100%;
  max-width: 480rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.num-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.num-key {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  border: 1rpx solid var(--divider);
  transition: all 0.15s ease;
}

.num-key:active {
  background: var(--divider);
  transform: scale(0.93);
}

.num-key.empty {
  background: transparent;
  border: none;
  pointer-events: none;
}

.num-key-text {
  font-size: 48rpx;
  font-weight: 500;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

/* ===== 底部 ===== */
.lock-footer {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.bio-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 36rpx;
  border-radius: 48rpx;
  background: var(--accent-bg);
  font-size: 28rpx;
  color: var(--accent);
  font-weight: 500;
  transition: all 0.15s ease;
}

.bio-btn:active {
  background: var(--accent-ring);
  transform: scale(0.96);
}

/* CSS 指纹图标 */
.css-icon-fingerprint {
  width: 28rpx;
  height: 32rpx;
  border: 3rpx solid var(--accent);
  border-radius: 50% 50% 40% 40%;
  position: relative;
}
.css-icon-fingerprint::after {
  content: '';
  width: 14rpx;
  height: 8rpx;
  border: 3rpx solid var(--accent);
  border-bottom: none;
  border-radius: 8rpx 8rpx 0 0;
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
}

.forgot-hint {
  font-size: 22rpx;
  color: var(--ink-faint);
  text-align: center;
  line-height: 1.6;
  padding: 0 40rpx;
}
