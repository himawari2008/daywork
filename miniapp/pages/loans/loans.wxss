/* ============================================
   活记 · 借支管理
   ============================================ */

/* Page */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 120rpx;
}

/* Tab bar */
.tab-bar {
  display: flex;
  background: var(--card);
  border-bottom: 2rpx solid #EEEDEA;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: var(--ink-faint);
  position: relative;
}

.tab.active {
  color: var(--accent);
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--accent);
  border-radius: 2rpx;
}

/* Skeleton */
.skeleton-list {
  padding: 32rpx;
}

.sk-item {
  padding: 32rpx;
  margin-bottom: 16rpx;
  background: var(--card);
  border-radius: 16rpx;
}

.sk-line {
  height: 24rpx;
  background: #EDEBE7;
  border-radius: 6rpx;
  margin-bottom: 12rpx;
}

.sk-wide { width: 60%; }
.sk-narrow { width: 35%; }

/* Empty */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 64rpx;
}

.empty-title {
  font-size: 32rpx;
  color: var(--ink-faint);
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #C0BDB8;
}

/* Summary card */
.summary-card {
  margin: 20rpx 32rpx;
  background: var(--card);
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
}

.summary-card:active {
  opacity: 0.85;
}

.sc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.sc-person {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sc-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #EDEBE7;
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sc-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}

.sc-net {
  font-size: 40rpx;
  font-weight: 700;
}

.sc-net.positive { color: #E05A44; }   /* 别人欠我 = danger red */
.sc-net.negative { color: #4CAF50; }   /* 我欠别人 = green (提醒还款) */
.sc-net.zero { color: var(--ink-faint); }

.sc-net-sign { font-size: 30rpx; }
.sc-net-amount { font-size: 40rpx; }

.sc-bottom {
  display: flex;
  gap: 40rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EEEDEA;
}

.sc-detail-row {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sc-detail-label {
  font-size: 24rpx;
  color: #B8B5B0;
}

.sc-detail-val {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
}

/* Loan item (detail list) */
.loan-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  margin: 0 32rpx 8rpx;
  background: var(--card);
  border-radius: 16rpx;
}

.loan-item:active {
  opacity: 0.85;
}

.loan-item.repaid {
  opacity: 0.5;
}

.li-left {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.li-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #EDEBE7;
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.li-body {
  flex: 1;
  min-width: 0;
}

.li-top-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.li-person {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.li-dir {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.li-dir.lend { background: #FDE8E4; color: #E05A44; }
.li-dir.borrow { background: #E8F5E9; color: #4CAF50; }

.li-reason {
  font-size: 26rpx;
  color: var(--ink-faint);
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.li-time {
  font-size: 22rpx;
  color: #C0BDB8;
  margin-top: 4rpx;
  display: block;
}

.li-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.li-amount {
  font-size: 32rpx;
  font-weight: 700;
}

.li-amount.lend { color: #E05A44; }
.li-amount.borrow { color: #4CAF50; }

.li-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.li-status.pending { background: #FFF3E8; color: #E8815C; }
.li-status.repaid { background: #F0F2F0; color: #8C8A85; }

/* FAB */
.fab {
  position: fixed;
  bottom: 48rpx;
  right: 48rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 8rpx 24rpx rgba(232, 129, 92, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.fab:active {
  transform: scale(0.92);
  opacity: 0.9;
}

.fab-icon {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.fab-icon::before,
.fab-icon::after {
  content: '';
  position: absolute;
  background: #fff;
  border-radius: 4rpx;
}

.fab-icon::before {
  width: 100%;
  height: 4rpx;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
}

.fab-icon::after {
  width: 4rpx;
  height: 100%;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
}

/* Modal */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.modal-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  padding: 40rpx 36rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
}

.modal-sheet.show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F2F1EE;
  font-size: 26rpx;
  color: var(--ink-faint);
}

/* Form */
.form-field {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--ink-faint);
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #F5F4F2;
  font-size: 30rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.form-toggle {
  display: flex;
  gap: 16rpx;
}

.form-tog {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 16rpx;
  background: #F5F4F2;
  font-size: 28rpx;
  color: var(--ink-faint);
  transition: all 0.2s;
}

.form-tog.active {
  font-weight: 600;
  color: #fff;
}

.form-tog.active.lend { background: #E05A44; }
.form-tog.active.borrow { background: #4CAF50; }

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.modal-cancel {
  background: #F2F1EE;
  color: var(--ink-faint);
}

.modal-save {
  background: var(--accent);
  color: #fff;
}

.modal-save:active {
  background: var(--accent-dim);
}

/* Dark theme */
.theme-dark { --bg: #1A1A1C; --card: #252528; --ink: #E8E6E3; --ink-faint: #8C8A85; }
.theme-dark .sk-line { background: #333336; }
.theme-dark .sc-avatar,
.theme-dark .li-avatar,
.theme-dark .modal-close { background: #333336; }
.theme-dark .form-input,
.theme-dark .form-tog { background: #2A2A2D; color: #C8C6C3; }
.theme-dark .modal-cancel { background: #333336; }
.theme-dark .li-dir.lend { background: rgba(224, 90, 68, 0.2); }
.theme-dark .li-dir.borrow { background: rgba(76, 175, 80, 0.2); }
.theme-dark .loan-item { border-bottom-color: #2A2A2D; }
