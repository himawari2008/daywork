/* 活记 · 涂鸦画板 */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FBFAF8;
}

.doodle-canvas {
  flex: 1;
  width: 100%;
  background: #fff;
}

/* 工具栏 */
.toolbar {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #FBFAF8;
  border-top: 1rpx solid #F0EDE8;
}
.tool-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 颜色芯片 */
.color-chip {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  transition: transform 0.15s;
}
.color-chip.active {
  border-color: #2D2B28;
  transform: scale(1.15);
}
.color-chip:active { transform: scale(0.92); }

/* 粗细芯片 */
.size-chip {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F0EDE8;
  border: 2rpx solid transparent;
  transition: all 0.15s;
}
.size-chip.active {
  border-color: #2D2B28;
  background: #E7E3DC;
}
.size-chip:active { transform: scale(0.92); }
.size-dot {
  border-radius: 50%;
  background: #2D2B28;
}

/* 操作按钮 */
.tool-actions {
  gap: 12rpx;
}
.tool-btn {
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  background: #F0EDE8;
  font-size: 24rpx;
  color: #7A7671;
  border: 1rpx solid transparent;
  transition: all 0.15s;
}
.tool-btn.active {
  background: #2D2B28;
  color: #fff;
}
.tool-btn:active { transform: scale(0.95); }

/* 完成栏 */
.done-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx);
  background: #FBFAF8;
}
.done-cancel {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border-radius: 48rpx;
  background: #F0EDE8;
  font-size: 30rpx;
  color: #7A7671;
  font-weight: 500;
}
.done-cancel:active { background: #E7E3DC; }
.done-submit {
  flex: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border-radius: 48rpx;
  background: #E8815C;
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}
.done-submit:active { background: #D07050; }
