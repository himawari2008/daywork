/* ========================================
   活记 v3 — 时间河流
   暖色有机极简 · 个人AI语音日记
   设计原则：呼吸感 · 灵动 · 活
   全平台零 emoji — CSS 纯图标
   ======================================== */

page {
  /* —— 暖白底色系 —— */
  --bg:         #FBFAF8;   /* 晨光暖白 */
  --surface:    #FFFFFF;   /* 纯白卡片 */
  --surface-sunken: #F2F1EE;   /* 次级控件底（未选中 chip/次级按钮）*/
  --divider:    #F0EDE8;   /* 暖色分割 */
  --shadow-card: 0 2rpx 12rpx rgba(0, 0, 0, 0.07);

  /* —— 墨色文字系 —— */
  --ink:        #2D2B28;   /* 暖墨色 */
  --ink-soft:   #7A7671;   /* 暖灰 */
  --ink-faint:  #B5B0A8;   /* 浅暖灰 */

  /* —— 珊瑚行动系 —— */
  --accent:      #E8815C;   /* 暮光珊瑚 */
  --accent-dim:  #D07050;   /* 按下加深 */
  --accent-bg:   #FFF2ED;   /* 珊瑚微光 */
  --accent-ring: #FDE0D6;   /* 珊瑚光环 */

  /* —— 品牌色 —— */
  --brand:       #4A5C7C;   /* 暮色深蓝 */

  /* —— 状态色 —— */
  --done:        #6EA880;   /* 暖绿 */
  --pending:     #C8A060;   /* 暖琥珀 */
  --followup:    #D4B860;   /* 暖金 */
  --danger:      #D08070;   /* 柔和红 */

  /* —— 心情色（AI自动识别） —— */
  --mood-happy:  #E8C86A;
  --mood-calm:   #7EBF8E;
  --mood-tired:  #C8A96E;
  --mood-stress: #E07B6C;
  --mood-angry:  #C07060;
  --mood-neutral:#B5B0A8;
  --mood-positive:#7EBF8E;   /* 正情绪 = 暖绿(同 calm) */
  --mood-negative:#E07B6C;   /* 负情绪 = 暖珊瑚(同 stress) */

  /* —— 热力图渐变 —— */
  --heat-0:      #F0EDE8;
  --heat-1:      #FDDCD0;
  --heat-2:      #FABBA0;
  --heat-3:      #F08E6E;
  --heat-4:      #E07B5A;

  /* —— 过渡 —— */
  transition: background 0.35s ease, color 0.35s ease;
}

/* ========================================
   暗色模式 · 夜深人静 · 活记依然温热
   ======================================== */
page.theme-dark {
  --bg:         #1A1A1C;
  --surface:    #262628;
  --surface-sunken: #2E2E30;   /* 次级控件底 */
  --divider:    #353538;
  --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.45);
  --ink:        #E8E6E1;
  --ink-soft:   #999690;
  --ink-faint:  #666360;
  --accent:     #E8815C;
  --accent-dim: #D07050;
  --accent-bg:  #2D1F1A;
  --accent-ring:#3D2820;
  --brand:      #7B8FB0;
  --done:       #6EA880;
  --pending:    #C8A060;
  --followup:   #D4B860;
  --danger:     #D08070;
  --heat-0:     #2A2A2D;
  --heat-1:     #3D2A22;
  --heat-2:     #5A3628;
  --heat-3:     #8A4830;
  --heat-4:     #E07B5A;
  /* 暗色下情绪色 */
  --mood-happy:  #A08840;
  --mood-calm:   #4E8A60;
  --mood-tired:  #8A7040;
  --mood-stress: #A04A3A;
  --mood-angry:  #8A4038;
  --mood-neutral:#666360;
  --mood-positive:#4E8A60;
  --mood-negative:#A04A3A;

  /* —— 排版 —— */
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ink);
  background-color: var(--bg);
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

/* ========================================
   CSS 纯图标体系 — 零 emoji
   ======================================== */

/* —— AI 生成合规标识（GB45438）：全局小角标 —— */
.ai-gen-badge {
  font-size: 20rpx;
  color: var(--ink-faint);
  opacity: 0.6;
  border: 1rpx solid var(--divider);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  line-height: 1.4;
}
.ai-gen-row {
  display: flex;
  margin-bottom: 8rpx;
}

/* —— AI 图标：呼吸光点（灵动智能感） —— */
.css-icon-ai {
  width: 40rpx;
  height: 40rpx;
  border-radius: 14rpx;
  background: var(--accent-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.css-icon-ai::after {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--accent);
  animation: icon-pulse 2.4s ease-in-out infinite;
}

/* —— 用户图标：留白圆形（纯粹的人） —— */
.css-icon-user {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--divider);
  background: var(--surface);
  position: relative;
}
.css-icon-user::after {
  content: '';
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--ink-soft);
  position: absolute;
  top: 7rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* —— 搜索图标：CSS 放大镜 —— */
.css-icon-search {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 3rpx solid var(--ink-faint);
  position: relative;
}
.css-icon-search::after {
  content: '';
  width: 3rpx;
  height: 12rpx;
  background: var(--ink-faint);
  position: absolute;
  bottom: -2rpx;
  right: -2rpx;
  border-radius: 2rpx;
  transform: rotate(-45deg);
  transform-origin: top center;
}

/* —— 麦克风图标：CSS 麦克风形状 —— */
.css-icon-mic {
  width: 18rpx;
  height: 28rpx;
  background: var(--accent);
  border-radius: 10rpx;
  position: relative;
}
.css-icon-mic::after {
  content: '';
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 3rpx solid var(--accent);
  border-top-color: transparent;
  border-right-color: transparent;
  position: absolute;
  bottom: -18rpx;
  left: 50%;
  transform: translateX(-50%) rotate(-45deg);
}

/* 录音中麦克风变白 */
.is-recording .css-icon-mic {
  background: rgba(255,255,255,0.9);
}
.is-recording .css-icon-mic::after {
  border-color: rgba(255,255,255,0.9);
  border-top-color: transparent;
  border-right-color: transparent;
}

/* —— 发送箭头上箭头 —— */
.css-icon-send {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #fff;
  border-right: 3rpx solid #fff;
  transform: rotate(45deg);
  margin-left: -4rpx;
}

/* —— 向下箭头（引导用） —— */
.css-icon-arrow-down {
  width: 20rpx;
  height: 20rpx;
  border-bottom: 2rpx solid var(--ink-faint);
  border-right: 2rpx solid var(--ink-faint);
  transform: rotate(45deg);
}

/* —— 周报/星光图标 —— */
.css-icon-spark {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--accent);
  position: relative;
}
.css-icon-spark::before,
.css-icon-spark::after {
  content: '';
  position: absolute;
  border-radius: 3rpx;
  background: var(--accent);
}
.css-icon-spark::before {
  width: 16rpx;
  height: 2rpx;
  top: 2rpx;
  left: -5rpx;
}
.css-icon-spark::after {
  width: 2rpx;
  height: 16rpx;
  left: 2rpx;
  top: -5rpx;
}

/* —— 连续模式图标（循环箭头） —— */
.css-icon-loop {
  width: 20rpx;
  height: 16rpx;
  border: 2rpx solid var(--ink-soft);
  border-radius: 50%;
  border-right-color: transparent;
  position: relative;
}
.css-icon-loop::after {
  content: '';
  width: 0;
  height: 0;
  border-left: 6rpx solid var(--ink-soft);
  border-top: 4rpx solid transparent;
  border-bottom: 4rpx solid transparent;
  position: absolute;
  top: -5rpx;
  right: -4rpx;
  transform: rotate(-30deg);
}

/* ========================================
   呼吸感动画体系
   ======================================== */

/* 光点脉动 — AI 思考中 */
@keyframes icon-pulse {
  0%, 100% { transform: scale(0.8); opacity: 0.5; }
  50%      { transform: scale(1.4); opacity: 1; }
}

/* 语音按钮 — 空闲呼吸光环 */
@keyframes breathe {
  0%, 100% { box-shadow: 0 0 0 0 rgba(232, 129, 92, 0.25); }
  50%      { box-shadow: 0 0 0 28rpx rgba(232, 129, 92, 0); }
}

/* 语音按钮 — 录音扩展波纹 */
@keyframes pulse-ring {
  0%   { transform: scale(1);    opacity: 0.5; }
  100% { transform: scale(2.2);  opacity: 0; }
}

/* 声波条跳动 — 有机的随机感 */
@keyframes wave-bar {
  0%, 100% { height: 8rpx;  }
  25%      { height: 32rpx; }
  50%      { height: 14rpx; }
  75%      { height: 40rpx; }
}

/* 记录入场 — 柔和 spring，从河面浮出 */
@keyframes flowIn {
  from { opacity: 0; transform: translateY(24rpx) scale(0.97); }
  to   { opacity: 1; transform: translateY(0)      scale(1); }
}

/* 空状态石子浮动 — 模拟浮在水面 */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-16rpx); }
}

/* 水波纹扩散 */
@keyframes ripple {
  0%   { transform: scale(0); opacity: 0.4; }
  100% { transform: scale(3.5); opacity: 0; }
}

/* 加载点呼吸 */
@keyframes breathe-dot {
  0%, 100% { opacity: 0.2; transform: scale(0.7); }
  50%      { opacity: 1;    transform: scale(1); }
}

/* 渐显 */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ========================================
   v4 新增动效 — 借鉴 react-bits
   ======================================== */

/* —— 弹性入场（react-bits Spring 风格） —— */
@keyframes springIn {
  0%   { opacity: 0; transform: translateY(32rpx) scale(0.94); }
  60%  { opacity: 1; transform: translateY(-4rpx) scale(1.01); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

/* —— 透明度 + 缩放出现（react-bits FadeContent） —— */
@keyframes fadeScale {
  from { opacity: 0; transform: scale(0.92); }
  to   { opacity: 1; transform: scale(1); }
}

/* —— 光扫过文字（react-bits ShinyText） —— */
@keyframes shimmer {
  0%   { background-position: -200% center; }
  100% { background-position: 200% center; }
}

/* —— 数字弹跳（react-bits Counter） —— */
@keyframes counterPop {
  0%   { transform: scale(1); }
  50%  { transform: scale(1.3); color: var(--accent); }
  100% { transform: scale(1); }
}

/* —— 粒子四散（react-bits Particles — 简化版用 opacity+scale 模拟） —— */
@keyframes particleBurst {
  0%   { opacity: 0.8; transform: scale(0) translate(0, 0); }
  100% { opacity: 0;   transform: scale(1) translate(var(--px, 20rpx), var(--py, -40rpx)); }
}

/* —— 涟漪扩散（Material Ripple） —— */
@keyframes rippleExpand {
  0%   { transform: scale(0); opacity: 0.5; }
  100% { transform: scale(4); opacity: 0; }
}

/* —— 侧抽屉滑入 —— */
@keyframes drawerSlideIn {
  from { transform: translateX(-100%); }
  to   { transform: translateX(0); }
}

@keyframes drawerSlideOut {
  from { transform: translateX(0); }
  to   { transform: translateX(-100%); }
}

/* —— 蒙层淡入 —— */
@keyframes overlayFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* —— 分组徽标呼吸闪烁（"活"的感觉） —— */
@keyframes groupDotPulse {
  0%, 100% { opacity: 0.7; transform: scale(1); }
  50%      { opacity: 1;   transform: scale(1.3); }
}

/* —— 图片预览条滑动入场 —— */
@keyframes slideUpFade {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ========================================
   v4 新增 CSS 纯图标
   ======================================== */

/* —— 汉堡菜单（侧抽屉开关） —— */
.css-icon-drawer {
  width: 32rpx;
  height: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
}
.css-icon-drawer::before,
.css-icon-drawer::after {
  content: '';
  width: 100%;
  height: 3rpx;
  background: var(--ink-soft);
  border-radius: 2rpx;
  transition: all 0.2s ease;
}
/* 中间线用 border 模拟 */
.css-icon-drawer {
  border-top: 3rpx solid var(--ink-soft);
  border-bottom: 3rpx solid var(--ink-soft);
}

/* —— 分组图标（小文件夹） —— */
.css-icon-group {
  width: 28rpx;
  height: 24rpx;
  background: var(--ink-faint);
  border-radius: 4rpx 4rpx 2rpx 2rpx;
  position: relative;
}
.css-icon-group::before {
  content: '';
  width: 12rpx;
  height: 6rpx;
  background: var(--ink-faint);
  border-radius: 2rpx 2rpx 0 0;
  position: absolute;
  top: -5rpx;
  left: 3rpx;
}

/* —— 图钉图标（置顶） —— */
.css-icon-pin {
  width: 12rpx;
  height: 12rpx;
  background: var(--accent);
  border-radius: 50%;
  position: relative;
}
.css-icon-pin::after {
  content: '';
  width: 3rpx;
  height: 14rpx;
  background: var(--accent);
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 2rpx;
}

/* —— 相机图标 —— */
.css-icon-camera {
  width: 28rpx;
  height: 22rpx;
  border: 3rpx solid var(--ink);
  border-radius: 5rpx;
  position: relative;
}
.css-icon-camera::after {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  border: 2rpx solid var(--ink);
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* —— 图片图标 —— */
.css-icon-image {
  width: 28rpx;
  height: 24rpx;
  border: 3rpx solid var(--ink);
  border-radius: 4rpx;
  position: relative;
}
.css-icon-image::after {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--ink);
  position: absolute;
  top: 3rpx;
  right: 3rpx;
}
.css-icon-image::before {
  content: '';
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-bottom: 8rpx solid var(--ink);
  position: absolute;
  bottom: 3rpx;
  left: 3rpx;
}

/* —— 粘贴/文档图标 —— */
.css-icon-paste {
  width: 22rpx;
  height: 28rpx;
  border: 3rpx solid var(--ink);
  border-radius: 3rpx;
  position: relative;
}
.css-icon-paste::after {
  content: '';
  width: 12rpx;
  height: 3rpx;
  background: var(--ink);
  border-radius: 2rpx;
  position: absolute;
  top: 6rpx;
  left: 3rpx;
  box-shadow: 0 7rpx 0 var(--ink), 0 14rpx 0 var(--ink);
}

/* —— 加号图标（用于 + 按钮） —— */
.css-icon-plus {
  width: 24rpx;
  height: 24rpx;
  position: relative;
}
.css-icon-plus::before,
.css-icon-plus::after {
  content: '';
  position: absolute;
  background: currentColor;
  border-radius: 3rpx;
}
.css-icon-plus::before {
  width: 100%;
  height: 4rpx;
  top: 50%;
  transform: translateY(-50%);
}
.css-icon-plus::after {
  width: 4rpx;
  height: 100%;
  left: 50%;
  transform: translateX(-50%);
}

/* —— 关闭/清除图标（×） —— */
.css-icon-close {
  width: 24rpx;
  height: 24rpx;
  position: relative;
}
.css-icon-close::before,
.css-icon-close::after {
  content: '';
  width: 100%;
  height: 3rpx;
  background: var(--ink-faint);
  border-radius: 3rpx;
  position: absolute;
  top: 50%;
  left: 0;
}
.css-icon-close::before { transform: rotate(45deg); }
.css-icon-close::after  { transform: rotate(-45deg); }

/* —— 对勾图标 —— */
.css-icon-check {
  width: 18rpx;
  height: 10rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg);
}

/* —— 视频/播放图标 —— */
.css-icon-video {
  width: 0;
  height: 0;
  border-left: 14rpx solid var(--ink);
  border-top: 9rpx solid transparent;
  border-bottom: 9rpx solid transparent;
  position: relative;
}

/* —— 涂鸦/画笔图标 —— */
.css-icon-doodle {
  width: 6rpx;
  height: 20rpx;
  background: #fff;
  border-radius: 3rpx;
  transform: rotate(-30deg);
  position: relative;
}
.css-icon-doodle::after {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-radius: 50% 50% 50% 0;
  background: #fff;
  position: absolute;
  top: -6rpx;
  left: -2rpx;
  transform: rotate(45deg);
}

/* —— 表格图标 —— */
.css-icon-table {
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid #fff;
  border-radius: 3rpx;
  position: relative;
}
.css-icon-table::before {
  content: '';
  width: 100%;
  height: 2rpx;
  background: #fff;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
}
.css-icon-table::after {
  content: '';
  width: 2rpx;
  height: 100%;
  background: #fff;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

/* —— 扫描图标 —— */
.css-icon-scan {
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid #fff;
  border-radius: 2rpx;
  position: relative;
}
.css-icon-scan::after {
  content: '';
  width: 14rpx;
  height: 2rpx;
  background: #fff;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  animation: scan-line 1.8s ease-in-out infinite;
}
@keyframes scan-line {
  0%, 100% { top: 30%; opacity: 0.3; }
  50%      { top: 70%; opacity: 1; }
}

/* —— 导入文件图标 —— */
.css-icon-import-file {
  width: 18rpx;
  height: 22rpx;
  border: 2rpx solid #fff;
  border-radius: 3rpx;
  position: relative;
}
.css-icon-import-file::after {
  content: '';
  width: 0;
  height: 0;
  border-left: 5rpx solid transparent;
  border-right: 5rpx solid transparent;
  border-top: 6rpx solid #fff;
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* —— 文档/分享图标 —— */
.css-icon-share-doc {
  width: 18rpx;
  height: 22rpx;
  border: 2rpx solid #fff;
  border-radius: 2rpx;
  position: relative;
}
.css-icon-share-doc::before {
  content: '';
  width: 10rpx;
  height: 2rpx;
  background: #fff;
  border-radius: 1rpx;
  position: absolute;
  top: 5rpx;
  left: 50%;
  transform: translateX(-50%);
  box-shadow: 0 5rpx 0 #fff;
}

/* ========================================
   v4 分组色变量（用于分组徽标）
   ======================================== */
page {
  --group-coral:  #E8815C;
  --group-blue:   #4A5C7C;
  --group-green:  #6EA880;
  --group-amber:  #C8A060;
  --group-purple: #8B7EC8;
  --group-gold:   #D4B860;
  --group-teal:   #5C9EAD;
  --group-rose:   #C0808B;
}

/* ========================================
   声波律动加载（活记品牌 · 呼应语音日记）
   全站统一组件，颜色跟随 --accent 自动适配暗色
   ======================================== */
.loader-eq {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 8rpx;
  height: 64rpx;
}
.loader-eq__bar {
  width: 10rpx;
  height: 64rpx;
  background: var(--accent);
  border-radius: 6rpx;
  transform-origin: bottom;
  animation: beat 1s ease-in-out infinite;
}
@keyframes beat {
  0%, 100% { transform: scaleY(0.3); }
  50%      { transform: scaleY(1); }
}
/* 尊重系统「减少动态效果」偏好 */
