# 数据库
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=weijiahang
DB_PASSWORD=your_db_password_here
DB_DATABASE=weijiahang_dev

# DeepSeek API（OpenAI 兼容格式，用于文本解析和对话）
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# 智谱 GLM-4-Flash API（备用）
ZHIPU_API_KEY=your_zhipu_api_key_here

# 通义千问 Qwen-VL 视觉模型（图片/视频AI解析）
QWEN_VL_API_KEY=your_qwen_vl_api_key_here

# 百度短语音识别 API（需在 console.bce.baidu.com 创建应用）
BAIDU_API_KEY=your_baidu_api_key_here
BAIDU_SECRET_KEY=your_baidu_secret_key_here

# 微信小程序（需在 mp.weixin.qq.com 获取）
WECHAT_APPID=your_wechat_appid_here
WECHAT_SECRET=your_wechat_secret_here

# JWT 密钥（生产环境请使用随机生成的长字符串）
JWT_SECRET=your_jwt_secret_change_in_production

# 服务端口
PORT=3000

# AI 模型 Base URL（可选，默认值如下）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
